# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# --- Environment / secrets ---
.env
!.env.example
api/.env
!api/.env.example
dashboard/.env
!dashboard/.env.example

# --- Node / dashboard ---
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
npm-debug.log*

# --- Jupyter ---
.ipynb_checkpoints/

# --- Model weights (large binaries, tracked outside git / via releases) ---
models/saved/*
!models/saved/.gitkeep

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp

# Keep VS Code launch config (portable, uses ${workspaceFolder}) but ignore
# personal per-machine editor settings if any get added later.
.vscode/*
!.vscode/launch.json
