APP_NAME=AI Inspection Platform
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

MOCK_MODE=true

CAMERA_ENABLED=false
CAMERA_DEVICE=raspberry_pi

AI_ENABLED=false
MODEL_PATH=./models

# Real conformity pipeline paths (only used when AI_ENABLED=true).
# Defaults assume api/ sits next to models/ and data/ at the project root.
CHECKPOINTS_DIR=../models/saved
REFERENCE_TABLE_PATH=../data/processed/reference_dimensions.json
TRACEES_PDF_DIR=../data/raw/reference
ANNOTATIONS_DIR=../data/processed
RESULTS_DIR=../data/results
TOLERANCE_CM=3.0
MIN_AREA_CM2=10.0

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
